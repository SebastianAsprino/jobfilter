{
	"name": "jobfilter",
	"version": "0.11.0",
	"description": "Busca vacantes en portales de empleo de Latinoamérica, filtra las empresas que reciclan ofertas y pinta cada vacante según tu perfil. Local y sin login.",
	"license": "MIT",
	"author": "Sebastian Asprino (https://asprino.dev)",
	"homepage": "https://github.com/SebastianAsprino/jobfilter#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SebastianAsprino/jobfilter.git"
	},
	"bugs": {
		"url": "https://github.com/SebastianAsprino/jobfilter/issues"
	},
	"keywords": [
		"job-search",
		"empleo",
		"vacantes",
		"latam",
		"sveltekit",
		"bun",
		"drizzle-orm",
		"sqlite",
		"scraper"
	],
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev --open",
		"dev:node": "vite dev --open",
		"buscar": "bun scripts/buscar.ts",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo"
	},
	"devDependencies": {
		"@sveltejs/adapter-bun": "1.0.2",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/better-sqlite3": "9.6.0",
		"@types/bun": "1.4.5",
		"@typescript/native": "npm:typescript@7.0.2",
		"drizzle-kit": "0.31.11",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.8"
	},
	"dependencies": {
		"better-sqlite3": "13.2.0",
		"drizzle-orm": "0.45.4"
	}
}