{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		// TypeScript no agrega la extensión al resolver "imports" de package.json ("#lib/x" no
		// encuentra x.ts); con paths sí la busca. Vite y Bun resuelven "imports" sin ayuda.
		"paths": { "#lib": ["./src/lib"], "#lib/*": ["./src/lib/*"] },
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "bun"]
	}
}
