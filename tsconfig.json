{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		// repetidos del tsconfig que genera SvelteKit: Bun no sigue "extends": "$app/tsconfig"
		"paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] },
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "bun"]
	}
}
